<?xml version="1.0"?>
<!-- Run the poser against the cell's calibration file.

     Bring the cell up first; this attaches to a running system rather than
     launching one, so it can be restarted freely while you work:

       ros2 launch <your_cell> <your_bringup>.launch.xml
       ros2 launch interactive_poser calibrate.launch.xml

     The file lists every calibratable joint. Switch between them from the
     marker's right-click menu, or pass target:=<joint_name> to start on one. -->
<launch>
  <arg name="calibration_file" default="/ros_ws/my_calibration.yaml"
       description="Copy config/example_calibration.yaml here, or point at the cell's own file."/>
  <arg name="target" default=""
       description="Joint to start on. Empty selects the first in the file."/>
  <arg name="use_sim_time" default="true"
       description="True against Gazebo or a bag; false on real hardware."/>
  <arg name="rviz" default="true"
       description="Start RViz preconfigured for calibration. Set false if you already have one."/>

  <node pkg="interactive_poser" exec="interactive_poser_node"
        name="interactive_poser" output="screen">
    <param name="calibration_file" value="$(var calibration_file)"/>
    <param name="target_calibration_joint" value="$(var target)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="marker_scale" value="0.25"/>
  </node>

  <!-- The node name is the interactive-marker namespace, so a renamed node
       needs calibration.rviz updated to match. -->
  <group if="$(var rviz)">
    <node pkg="rviz2" exec="rviz2" name="calibration_rviz" output="screen"
          args="-d $(find-pkg-share interactive_poser)/config/calibration.rviz">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
  </group>
</launch>
